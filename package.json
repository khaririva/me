{
  "name": "pustakaloka",
  "description": "PustakaLoka — Pembaca EPUB & Terjemahan AI",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "icons": "node scripts/generate-icons.mjs",
    "icons:cap": "npx capacitor-assets generate",
    "build": "vite build",
    "build:html": "node scripts/build-single-html.mjs",
    "build:mac:dmg": "bash scripts/build-mac-dmg.sh",
    "cap:sync": "npm run build && npx cap sync android",
    "build:android:apk": "bash scripts/build-android-apk.sh",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-html server.js release",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.pustakamac.epubreader",
    "productName": "PustakaLoka",
    "icon": "assets/icon.png",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "mac": {
      "category": "public.app-category.books",
      "icon": "assets/icon.png",
      "darkModeSupport": true
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@google/genai": "^3.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "epubjs": "^0.3.93",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
